From: DWI maintainers <noreply@localhost>
Subject: [PATCH] flutter_tools: order web build hooks before web compilation

Base: Flutter 3.47.6 stable (framework 5fc346839b, engine 692136cb65)
Apply from the Flutter repository root with:
  git apply flutter-web-hook-ordering.patch

This is a prototype for discussion in https://github.com/dart-lang/sdk/issues/56512.
It makes the common web compile target depend on BuildHooks(platform: web) so
that Dart sources generated by a dependency's web build hook exist before
dart2js or dart2wasm starts. It does not claim a supported generated-source
contract, and it has not been accepted or merged upstream.

---
--- a/packages/flutter_tools/lib/src/build_system/targets/web.dart
+++ b/packages/flutter_tools/lib/src/build_system/targets/web.dart
@@ -143,6 +143,10 @@
   List<Target> get dependencies => const <Target>[
     WebEntrypointTarget(),
     GenerateLocalizationsTarget(),
+    // A dependency's web build hook may generate Dart sources that the
+    // application imports. The compiler must not start until those hooks have
+    // run. See https://github.com/dart-lang/sdk/issues/56512.
+    BuildHooks(platform: HookPlatform.web),
   ];
 
   @override
--- a/packages/flutter_tools/test/general.shard/build_system/targets/web_test.dart
+++ b/packages/flutter_tools/test/general.shard/build_system/targets/web_test.dart
@@ -12,6 +12,7 @@
 import 'package:flutter_tools/src/build_info.dart';
 import 'package:flutter_tools/src/build_system/build_system.dart';
 import 'package:flutter_tools/src/build_system/depfile.dart';
+import 'package:flutter_tools/src/build_system/targets/native_assets.dart';
 import 'package:flutter_tools/src/build_system/targets/web.dart';
 import 'package:flutter_tools/src/dart/pub.dart';
 import 'package:flutter_tools/src/globals.dart' as globals;
@@ -1404,7 +1405,30 @@
       }
     }
   }
+
+  group('web compile targets wait for web build hooks', () {
+    testWithoutContext('Dart2JSTarget depends on the web build hooks target', () {
+      final Target target = Dart2JSTarget(const JsCompilerConfig());
+
+      final List<BuildHooks> hooks = target.dependencies.whereType<BuildHooks>().toList();
+
+      expect(hooks, hasLength(1));
+      expect(hooks.single.platform, HookPlatform.web);
+    });
+
+    testWithoutContext('Dart2WasmTarget depends on the web build hooks target', () {
+      final Target target = Dart2WasmTarget(
+        const WasmCompilerConfig(),
+        const NoOpAnalytics(),
+      );
 
+      final List<BuildHooks> hooks = target.dependencies.whereType<BuildHooks>().toList();
+
+      expect(hooks, hasLength(1));
+      expect(hooks.single.platform, HookPlatform.web);
+    });
+  });
+
   test('Dart2JSTarget has unique build keys for compiler configurations', () {
     const testConfigs = <JsCompilerConfig>[
       // Default values
--- /dev/null
+++ b/packages/flutter_tools/test/integration.shard/build_hooks_generate_dart_web_test.dart
@@ -0,0 +1,104 @@
+// Copyright 2014 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'package:file/file.dart';
+import 'package:flutter_tools/src/base/io.dart';
+
+import '../src/common.dart';
+import 'isolated/native_assets_test_utils.dart';
+import 'test_utils.dart';
+
+/// Regression test for web build hooks that generate a Dart source file.
+///
+/// A build hook may write a Dart file that the application imports. Before the
+/// web compiler depended on [BuildHooks] for web, `dart2js` could start before
+/// the hook ran and the first build failed on the missing import. This test
+/// performs a genuinely first `flutter build web` on an app whose build hook
+/// creates `lib/generated.g.dart`, which `lib/main.dart` imports.
+void main() {
+  if (!platform.isMacOS && !platform.isLinux && !platform.isWindows) {
+    return;
+  }
+
+  testWithoutContext('first flutter build web sees Dart sources from a build hook', () async {
+    await inTempDir((Directory tempDirectory) async {
+      final ProcessResult create = await processManager.run(<String>[
+        flutterBin,
+        'create',
+        '--no-pub',
+        '--platforms=web',
+        'app',
+      ], workingDirectory: tempDirectory.path);
+      expect(create, const ProcessResultMatcher());
+
+      final Directory app = tempDirectory.childDirectory('app');
+
+      app.childFile('pubspec.yaml').writeAsStringSync('''
+name: app
+description: "web build hook generated Dart source"
+publish_to: 'none'
+version: 1.0.0+1
+
+environment:
+  sdk: ^3.13.0
+
+dependencies:
+  flutter:
+    sdk: flutter
+  hooks: ^2.2.0
+
+flutter:
+  uses-material-design: true
+''');
+
+      app.childFile('lib/main.dart').writeAsStringSync('''
+import 'package:flutter/material.dart';
+
+// Compile-time dependency on a file written by this package's build hook.
+import 'generated.g.dart';
+
+void main() => runApp(MaterialApp(home: Text('\$generatedValue')));
+''');
+
+      app.childDirectory('hook').createSync();
+      app.childDirectory('hook').childFile('build.dart').writeAsStringSync('''
+import 'dart:io';
+
+import 'package:hooks/hooks.dart';
+
+void main(List<String> args) async {
+  await build(args, (input, output) async {
+    final File generated = File.fromUri(
+      input.packageRoot.resolve('lib/generated.g.dart'),
+    );
+    generated.writeAsStringSync('const int generatedValue = 42;\\n');
+  });
+}
+''');
+
+      final ProcessResult pubGet = await processManager.run(<String>[
+        flutterBin,
+        'pub',
+        'get',
+      ], workingDirectory: app.path);
+      expect(pubGet, const ProcessResultMatcher());
+
+      // No generated file exists before this, and it is the first build.
+      expect(app.childFile('lib/generated.g.dart').existsSync(), isFalse);
+
+      final ProcessResult build = await processManager.run(<String>[
+        flutterBin,
+        'build',
+        'web',
+        '--release',
+        '--no-pub',
+      ], workingDirectory: app.path);
+      expect(build, const ProcessResultMatcher());
+      expect(build.stdout as String, contains('Built build/web'));
+
+      expect(app.childFile('lib/generated.g.dart').existsSync(), isTrue);
+      expect(app.childFile('build/web/main.dart.js').existsSync(), isTrue);
+    });
+  });
+}
